{
  "name": "portfolio-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "API for the portfolio: owner login (Render + TiDB/MySQL).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "start": "node src/index.ts",
