# Copy to server/.env for local runs. On Render, set these in the service's Environment tab.

# TiDB Cloud: Connect > "General" connection string (mysql://USER:PASSWORD@HOST:4000/DATABASE)
DATABASE_URL=
# Only for a local MySQL without TLS (e.g. mysql://root:PASSWORD@127.0.0.1:3306/portfolio):
# DATABASE_SSL=false

# Random string, 32+ characters, signs login tokens. Changing it logs the owner out.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Sites allowed to call the API, comma-separated
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
